<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>redirect</title>
</head>
<body>
    <p id="err"></p>
    <script>
        const main = async() => {
            localStorage.clear()
            try{
                const data = await fetch("/discord/flash", {
                    method:"POST",
                    headers:{
                        "Content-Type":"application/json"
                    },
                    credentials: "include"
                })
                const redirect = await data.json()
                window.location.assign(redirect.go)
            } catch(err){
                document.querySelector("#err").textContent("somthing is worng")
            }
        }
        main()
    </script>
</body>
</html>